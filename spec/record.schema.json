{
  "$defs": {
    "Action": {
      "description": "Something the document owner must do before or after acceptance, derived from a failed finding.",
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Id"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "owner": {
          "default": "",
          "title": "Owner",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "disputed",
            "done"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "decision_id",
        "severity",
        "summary"
      ],
      "title": "Action",
      "type": "object"
    },
    "AdvisoryAnswer": {
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
