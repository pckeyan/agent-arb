        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "default": "",
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "decision_id",
        "question"
      ],
      "title": "AdvisoryAnswer",
      "type": "object"
    },
    "Approval": {
      "description": "One stakeholder's acceptance. The date is the acceptance; a pending row has none.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
