  {
   "id": "IND-RES-002",
   "title": "Retries have backoff, jitter and a budget, and only wrap idempotent calls",
   "scope": "architecture",
   "target": "decision",
   "type": "check",
   "severity": "high",
   "tags": [
    "resilience",
    "retry",
    "idempotency"
   ],
   "requirement": "Where a call is retried, the policy states the backoff, that jitter is applied, the maximum attempts or a retry budget, and shows that the retried operation is idempotent or made so with an idempotency key.",
