  {
   "id": "IND-RES-003",
   "title": "Isolate dependencies with circuit breakers or bulkheads",
   "scope": "architecture",
   "target": "decision",
   "type": "check",
   "severity": "medium",
   "tags": [
    "resilience",
    "failure",
    "coupling"
   ],
   "requirement": "A slow or failing dependency cannot exhaust the caller's threads, connections or queue. The design names the isolation mechanism, for example a circuit breaker per dependency or a separate pool per dependency.",
