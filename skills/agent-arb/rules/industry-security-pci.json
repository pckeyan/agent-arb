  {
   "id": "IND-SEC-PCI-001",
   "title": "Inventory the cardholder data elements each flow touches",
   "scope": "architecture",
   "target": "decision",
   "type": "check",
   "severity": "critical",
   "tags": [
    "pci",
    "cardholder-data",
    "data",
    "security"
   ],
   "requirement": "Each flow that handles payment card data lists which elements it touches, such as the primary account number, cardholder name, expiry date and service code, and whether any sensitive authentication data such as the full track, card verification code or PIN is ever present.",
   "question": "",
   "evidence_hints": [
