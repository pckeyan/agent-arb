   "target": "decision",
   "type": "check",
   "severity": "critical",
   "tags": [
    "auth",
    "security",
    "identity"
   ],
   "requirement": "No service accepts a call because it arrives from an internal network, a VPC, a private load balancer or a known IP range. Each call carries a verifiable identity.",
